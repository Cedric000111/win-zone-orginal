/* =========================================================
   WIN ZONE — GLOBAL STYLESHEET
   ========================================================= */

:root {
    --wz-bg: #05050b;
    --wz-bg-secondary: #0b1020;
    --wz-card: #101426;
    --wz-card-light: #171b30;

    --wz-primary: #00ffd5;
    --wz-primary-dark: #00c9aa;

    --wz-secondary: #9d6cff;
    --wz-warning: #ffc857;
    --wz-danger: #ff6464;
    --wz-success: #38e08f;

    --wz-white: #ffffff;
    --wz-text: #e5e7eb;
    --wz-muted: #9ca3af;
    --wz-dark-muted: #6b7280;

    --wz-border: rgba(255, 255, 255, 0.10);

    --wz-radius-sm: 10px;
    --wz-radius-md: 14px;
    --wz-radius-lg: 20px;
    --wz-radius-xl: 28px;

    --wz-shadow:
        0 25px 70px rgba(0, 0, 0, 0.45);

    --wz-transition: 0.2s ease;
}

/* =========================================================
   RESET
   ========================================================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    font-family:
        Arial,
        Helvetica,
        sans-serif;

    background:
        radial-gradient(
            circle at top left,
            rgba(0, 255, 213, 0.08),
            transparent 32%
        ),
        radial-gradient(
            circle at bottom right,
            rgba(157, 108, 255, 0.10),
            transparent 32%
        ),
        var(--wz-bg);

    color: var(--wz-white);
    line-height: 1.5;
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

a {
    color: inherit;
}

/* =========================================================
   COMMON CONTAINER
   ========================================================= */

.wz-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

/* =========================================================
   GLOBAL HEADER
   ========================================================= */

.wz-header {
    width: 100%;
    border-bottom: 1px solid var(--wz-border);
    background: rgba(5, 5, 11, 0.88);
    backdrop-filter: blur(15px);
}

.wz-header-inner {
    min-height: 70px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;
}

.wz-logo {
    text-decoration: none;

    font-size: 27px;
    font-weight: 900;
    letter-spacing: 3px;

    background:
        linear-gradient(
            90deg,
            var(--wz-primary),
            var(--wz-white),
            var(--wz-secondary)
        );

    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

/* =========================================================
   BUTTONS
   ========================================================= */

.wz-button {
    display: inline-flex;

    justify-content: center;
    align-items: center;

    min-height: 46px;

    padding: 12px 20px;

    border: 1px solid var(--wz-border);
    border-radius: var(--wz-radius-md);

    background: var(--wz-card-light);
    color: var(--wz-white);

    text-decoration: none;

    font-size: 14px;
    font-weight: 700;

    transition:
        transform var(--wz-transition),
        box-shadow var(--wz-transition),
        border-color var(--wz-transition);
}

.wz-button:hover {
    transform: translateY(-2px);
    border-color: rgba(0, 255, 213, 0.5);
}

.wz-button-primary {
    background:
        linear-gradient(
            90deg,
            var(--wz-primary-dark),
            var(--wz-primary)
        );

    color: #03110e;
    border: none;
}

.wz-button-primary:hover {
    box-shadow:
        0 12px 30px rgba(0, 255, 213, 0.20);
}

.wz-button-danger {
    background:
        linear-gradient(
            90deg,
            #ff5656,
            #ff884d
        );

    color: #170707;
    border: none;
}

.wz-button-success {
    background:
        linear-gradient(
            90deg,
            #28c979,
            #45ee9a
        );

    color: #03110e;
    border: none;
}

/* =========================================================
   CARDS
   ========================================================= */

.wz-card {
    background: rgba(16, 20, 38, 0.88);

    border: 1px solid var(--wz-border);

    border-radius: var(--wz-radius-lg);

    box-shadow: var(--wz-shadow);

    backdrop-filter: blur(15px);
}

/* =========================================================
   FORMS
   ========================================================= */

.wz-label {
    display: block;

    margin-bottom: 8px;

    color: var(--wz-text);

    font-size: 14px;
    font-weight: 600;
}

.wz-input,
.wz-select,
.wz-textarea {
    width: 100%;

    padding: 14px 15px;

    border: 1px solid #2d3552;
    border-radius: var(--wz-radius-sm);

    outline: none;

    background: #0b1020;
    color: var(--wz-white);

    transition:
        border-color var(--wz-transition),
        box-shadow var(--wz-transition);
}

.wz-input:focus,
.wz-select:focus,
.wz-textarea:focus {
    border-color: var(--wz-primary);

    box-shadow:
        0 0 0 3px rgba(0, 255, 213, 0.08);
}

.wz-textarea {
    min-height: 130px;
    resize: vertical;
}

/* =========================================================
   STATUS BADGES
   ========================================================= */

.wz-badge {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 6px 11px;

    border-radius: 50px;

    font-size: 11px;
    font-weight: 800;

    letter-spacing: 0.6px;
}

.wz-badge-success {
    color: #75f5b2;
    background: rgba(56, 224, 143, 0.10);
    border: 1px solid rgba(56, 224, 143, 0.20);
}

.wz-badge-warning {
    color: #ffd76a;
    background: rgba(255, 200, 87, 0.10);
    border: 1px solid rgba(255, 200, 87, 0.20);
}

.wz-badge-danger {
    color: #ff8585;
    background: rgba(255, 100, 100, 0.10);
    border: 1px solid rgba(255, 100, 100, 0.20);
}

/* =========================================================
   TEXT HELPERS
   ========================================================= */

.wz-muted {
    color: var(--wz-muted);
}

.wz-small {
    font-size: 12px;
}

.wz-center {
    text-align: center;
}

/* =========================================================
   SPACING HELPERS
   ========================================================= */

.wz-mt-1 {
    margin-top: 8px;
}

.wz-mt-2 {
    margin-top: 16px;
}

.wz-mt-3 {
    margin-top: 24px;
}

.wz-mb-1 {
    margin-bottom: 8px;
}

.wz-mb-2 {
    margin-bottom: 16px;
}

.wz-mb-3 {
    margin-bottom: 24px;
}

/* =========================================================
   FOOTER
   ========================================================= */

.wz-footer {
    margin-top: 40px;

    padding: 25px 20px;

    border-top: 1px solid var(--wz-border);

    color: var(--wz-dark-muted);

    text-align: center;

    font-size: 12px;
}

.wz-footer a {
    color: var(--wz-muted);
    text-decoration: none;
}

.wz-footer a:hover {
    color: var(--wz-primary);
}

/* =========================================================
   RESPONSIVE DESIGN
   ========================================================= */

@media (max-width: 700px) {

    .wz-container {
        padding: 0 15px;
    }

    .wz-header-inner {
        min-height: 62px;
    }

    .wz-logo {
        font-size: 22px;
    }

    .wz-button {
        width: 100%;
    }
}

/* =========================================================
   ACCESSIBILITY
   ========================================================= */

:focus-visible {
    outline: 2px solid var(--wz-primary);
    outline-offset: 3px;
}

/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition: none !important;
        animation: none !important;
    }
}
